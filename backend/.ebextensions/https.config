# Add an HTTPS:443 listener on the ALB using the us-east-2 ACM cert for
# fairwitness-api.orchestratorstudios.ai. (Port 80 stays for direct/redirect.)
option_settings:
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:us-east-2:183944926635:certificate/19611bc6-b203-4150-a0fb-65fc53ca5503
