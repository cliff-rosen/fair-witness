# Copy to .env (local dev) and fill in. Production values live in .env.production
# (git-ignored, shipped in the EB bundle via .ebignore).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CLAUDE_MODEL=claude-sonnet-4-20250514
MAX_PARALLEL_EVALUATORS=8
MAX_ARTICLE_CHARS=40000
LOG_LEVEL=INFO

# Access gate. Empty = no gate (open, dev). In prod, set a shared passphrase.
APP_PASSWORD=

# Frontend origin used for CORS in production.
FRONTEND_URL=https://fairwitness.orchestratorstudios.ai

# Database — shared MariaDB on RDS (`chatter`), new `fairwitness` schema.
# Local dev connects to the same instance.
DB_HOST=chatter.c0guz2wkpcod.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=fairwitness
DB_USER=
DB_PASSWORD=
